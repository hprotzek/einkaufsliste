# Copy to .env and adjust. .env is gitignored and must never be committed:
# assume anything committed to a public repo is permanently public, even after
# a force-push (spec §12.4).

# --- API ---------------------------------------------------------------------

# Postgres connection string. Required — the API exits immediately without it,
# rather than falling back to a default that might point at the wrong database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/einkaufsliste?sslmode=disable

# Listen address. Defaults to :8080 when unset.
ADDR=:8080

# One of debug, info, warn, error. Anything unrecognised falls back to info,
# so a typo cannot silence the logs.
LOG_LEVEL=info
