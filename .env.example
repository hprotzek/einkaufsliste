# Copy to .env and adjust. .env is gitignored and must never be committed:
# assume anything committed to a public repo is permanently public, even after
# a force-push (spec §12.4).

# --- API ---------------------------------------------------------------------

# Postgres connection string. Required — the API exits immediately without it,
# rather than falling back to a default that might point at the wrong database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/einkaufsliste?sslmode=disable

# Listen address. Defaults to :8080 when unset.
ADDR=:8080

# One of debug, info, warn, error. Anything unrecognised falls back to info,
# so a typo cannot silence the logs.
LOG_LEVEL=info

# --- Auth -------------------------------------------------------------------

# Signs this server's own access tokens. Required, at least 32 bytes, and the
# process refuses to start on anything shorter. Generate one with:
#   openssl rand -hex 32
AUTH_SIGNING_KEY=replace-this-with-openssl-rand-hex-32-output-0000

# From the Google Cloud console, OAuth client of type "Web application".
# The redirect URI must match the one the web app sends.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to false only for a local stack served over plain HTTP. Leaving it false
# in production would put the refresh token on the wire in the clear.
COOKIE_SECURE=true

# --- Compose stack (make up) -------------------------------------------------
# DATABASE_URL above is for running the API directly against your own Postgres.
# Inside the stack it is assembled from the three values below, pointing at the
# postgres service.

# Required, with no default on purpose: a shipped default password is a
# password everybody has. `make up` fails loudly until this is set.
POSTGRES_PASSWORD=change-me-before-running

POSTGRES_USER=einkaufsliste
POSTGRES_DB=einkaufsliste

# Host port Caddy listens on. In production the tunnel reaches Caddy over the
# container network and nothing is published on the host at all.
HTTP_PORT=8080
